# Where form submissions (trial, demo, contact, partner) are POSTed as JSON.
# Leave empty during development: forms validate and show success without sending.
# Set to /api/submit-form to use the Postmark-backed function in api/submit-form.js.
VITE_FORMS_ENDPOINT=
# The SwiftOwl app's sign-in URL, used by the "Sign in" link.
VITE_APP_URL=https://access.swiftowl.ai

# --- api/submit-form.js (server-side only — no VITE_ prefix, never reaches the browser) ---
# Postmark server token. Set the real value in Vercel's project env vars, not here.
POSTMARK_API_KEY=
# Verified sender address for both the internal notification and the acknowledgment.
POSTMARK_FROM_EMAIL=no-reply@swiftowl.ai
# Internal inbox that receives a notification for every form submission.
NOTIFY_TO_EMAIL=
